DATABASE_URL="file:./dev.db"
ADMIN_EMAIL="admin@thewearco.local"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="a-32+char-random-string-change-in-prod"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Test login: any phone OTP / any email+password creates a session.
# Set to 0 in real production. Non-production NODE_ENV also enables bypass.
AUTH_TEST_BYPASS="1"
NEXT_PUBLIC_AUTH_TEST_BYPASS="1"

# ─────────────── Razorpay (payments) ─────────────────────────────────────
# Dashboard → Settings → API Keys. Use "key_test_..." in test mode.
# When these are empty, the app runs in "demo mode" and marks online
# orders as paid immediately so local dev still works.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dashboard → Settings → Webhooks. Register:
#   URL      <NEXT_PUBLIC_SITE_URL>/api/payments/webhook
#   Events   payment.captured, payment.failed, refund.processed
#   Secret   <RAZORPAY_WEBHOOK_SECRET>
RAZORPAY_WEBHOOK_SECRET=""

# ─────────────── Resend (transactional email) ────────────────────────────
# https://resend.com/api-keys  — free tier covers the first 3,000 emails/mo.
# When empty, order emails log to the server console instead of being sent.
RESEND_API_KEY=""
MAIL_FROM="TheWearCo <orders@thewearco.com>"
MAIL_REPLY_TO="hi@thewearco.com"

# On Vercel, also set SESSION_SECRET (32+ chars), ADMIN_EMAIL, ADMIN_PASSWORD
# in Project Settings → Environment Variables. DATABASE_URL is set in vercel.json.
