generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  tagline       String
  category      String
  price         Int
  drop          String
  description   String
  details       String
  printArea     String
  printShape    String         @default("rect")
  customizable  Boolean        @default(true)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  colors        ProductColor[]
  sizes         ProductSize[]
}

model ProductColor {
  id           String  @id @default(cuid())
  productId    String
  name         String
  hex          String
  fabric       String
  printDefault String
  sortOrder    Int     @default(0)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  label     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      String      @default("pending")
  email       String
  name        String
  phone       String
  gst         String?
  subtotal    Int
  shipping    Int
  total       Int
  address     String
  paymentMethod String    @default("upi")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productSlug     String
  name            String
  price           Int
  qty             Int
  size            String
  color           String
  customDesign    String?
  designImagePath String?
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BulkQuote {
  id                   String   @id @default(cuid())
  status               String   @default("new") // new | reviewing | quoted | won | lost
  email                String
  name                 String
  company              String?
  phone                String?
  productSlug          String?  // optional — may be "custom" if they want a bespoke product
  productName          String?  // free-text if productSlug is null
  category             String?
  qty                  Int
  color                String?
  size                 String?
  printShape           String?
  deadline             DateTime?
  message              String
  fileUrl              String?  // artwork upload (optional)
  // Snapshot of what the live calculator showed the customer:
  estimatedUnitPrice   Int?     // INR per unit after discount
  estimatedTotal       Int?     // INR total
  tierDiscountPercent  Int?     // 0-50
  adminNotes           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}
